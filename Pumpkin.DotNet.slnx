<Solution>
  <Folder Name="/samples/">
    <Project Path="samples/Pumpkin.DotNet.Sample/Pumpkin.DotNet.Sample.csproj">
      <Build Solution="*|*" Project="false" />
    </Project>
  </Folder>

  <Folder Name="/src/">
    <Project Path="src/Pumpkin.DotNet.SourceGenerator/Pumpkin.DotNet.SourceGenerator.csproj" />
    <Project Path="src/Pumpkin.DotNet.Api/Pumpkin.DotNet.Api.csproj" />

    <Project Path="src/Pumpkin.DotNet.Runtime/Pumpkin.DotNet.Runtime.csproj">
      <BuildDependency Project="src/Pumpkin.DotNet.SourceGenerator/Pumpkin.DotNet.SourceGenerator.csproj" />
      <BuildDependency Project="tools/Pumpkin.DotNet.Tools.WitPostProcessor/Pumpkin.DotNet.Tools.WitPostProcessor.csproj" />
    </Project>

    <Project Path="src/Pumpkin.DotNet.Sdk/Pumpkin.DotNet.Sdk.csproj">
      <BuildDependency Project="src/Pumpkin.DotNet.Runtime/Pumpkin.DotNet.Runtime.csproj" />
    </Project>

    <Project Path="tools/Pumpkin.DotNet.Tools.WitPostProcessor/Pumpkin.DotNet.Tools.WitPostProcessor.csproj" />
  </Folder>

  <Folder Name="/tests/">
    <Project Path="tests/Pumpkin.DotNet.Tests/Pumpkin.DotNet.Tests.csproj" />
  </Folder>
</Solution>
<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net11.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">wasi-wasm</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimMode>full</TrimMode>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <NativeDebugSymbols>false</NativeDebugSymbols>
    <StripSymbols>true</StripSymbols>

    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>

    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <UseAppHost>false</UseAppHost>

    <PumpkinDotNetVersion>0.2.0-alpha</PumpkinDotNetVersion>

    <StackTraceSupport>false</StackTraceSupport>
    <IlcDisableReflection>true</IlcDisableReflection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pumpkin.DotNet.Api"
                      Version="$(PumpkinDotNetVersion)" />

    <PackageReference Include="Pumpkin.DotNet.Runtime"
                      Version="$(PumpkinDotNetVersion)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="config.toml" Condition="Exists('config.toml')" />
    <EmbeddedResource Include="config.json" Condition="Exists('config.json')" />
  </ItemGroup>

  <PropertyGroup>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

</Project>

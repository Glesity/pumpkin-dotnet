<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimMode>full</TrimMode>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <!-- The SDK target in preview00011 contains a typo in this property name. -->
    <WitBindgenAdditionalArgs>--internal</WitBindgenAdditionalArgs>
    <WitBindgenAddtionalArgs>--internal</WitBindgenAddtionalArgs>

    <Version>0.2.0-alpha</Version>
    <PackageId>Pumpkin.DotNet.Runtime</PackageId>

    <NoWarn>$(NoWarn);CS0618;NETSDK1057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BytecodeAlliance.Componentize.DotNet.WitBindgen" Version="0.8.0-preview00011" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />

    <ProjectReference Include="..\Pumpkin.DotNet.Api\Pumpkin.DotNet.Api.csproj" />
    <ProjectReference Include="..\Pumpkin.DotNet.SourceGenerator\Pumpkin.DotNet.SourceGenerator.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" PrivateAssets="all" />
    <ProjectReference Include="..\..\tools\Pumpkin.DotNet.Tools.WitPostProcessor\Pumpkin.DotNet.Tools.WitPostProcessor.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" PrivateAssets="all" />
  </ItemGroup>

  <UsingTask TaskName="StripWitInitPluginExportTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (System.IO.File.Exists(FilePath))
        {
            var text = System.IO.File.ReadAllText(FilePath);
            var original = text;

            text = text.Replace(
              """[global::System.Runtime.InteropServices.UnmanagedCallersOnlyAttribute(EntryPoint = "init-plugin")]""",
              """[global::System.Runtime.InteropServices.UnmanagedCallersOnlyAttribute(EntryPoint = "init-plugin-hidden")]""");

            if (text != original)
            {
                System.IO.File.WriteAllText(
                    FilePath,
                    text,
                    new System.Text.UTF8Encoding(false));
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- ============================================================
       1. Apply generated-code collision fixes strictly after wit-bindgen
       ============================================================ -->
  <Target Name="StripWitInitPluginExport"
          AfterTargets="WitCompile_BeforeCsCompile"
          BeforeTargets="RunWitPostProcessor">

    <ItemGroup>
      <_WitPluginFile Include="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)wit_bindgen/**/*Plugin.cs" />
    </ItemGroup>

    <StripWitInitPluginExportTask
      FilePath="%(_WitPluginFile.Identity)"
      Condition="Exists('%(_WitPluginFile.Identity)')" />
  </Target>

  <!-- ============================================================
       2. Split WIT switch code strictly after StripWitInitPluginExport
       ============================================================ -->
  <PropertyGroup>
    <_WitPostProcessorProject>$(MSBuildThisFileDirectory)..\..\tools\Pumpkin.DotNet.Tools.WitPostProcessor\Pumpkin.DotNet.Tools.WitPostProcessor.csproj</_WitPostProcessorProject>
  </PropertyGroup>

  <Target Name="RunWitPostProcessor"
          AfterTargets="StripWitInitPluginExport"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences;WitCompile_BeforeCsCompile">

    <PropertyGroup>
      <_WitBindgenDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)wit_bindgen'))</_WitBindgenDir>
    </PropertyGroup>

    <MSBuild Projects="$(_WitPostProcessorProject)"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="_WitPostProcessorDll" />
    </MSBuild>

    <Exec Condition="Exists('$(_WitBindgenDir)')"
          Command="dotnet &quot;$(_WitPostProcessorDll)&quot; --directory &quot;$(_WitBindgenDir)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />

    <ItemGroup Condition="Exists('$(_WitBindgenDir)')">
      <Compile Remove="@(Compile)" Condition="!Exists('%(Compile.FullPath)')" />
      <Compile Include="$(_WitBindgenDir)/**/*.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

  <!-- ============================================================
       WIT definitions for building Runtime itself
       ============================================================ -->
  <ItemGroup>
    <Wit Include="$(MSBuildThisFileDirectory)..\..\wit\v0.1\" World="plugin" />
    <Wit Include="$(BaseIntermediateOutputPath)wit_registry\io.wasm" World="imports" Registry="ghcr.io/webassembly/wasi/io:0.2.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Pumpkin.DotNet.SourceGenerator\bin\$(Configuration)\netstandard2.0\Pumpkin.DotNet.SourceGenerator.dll"
          Pack="true"
          PackagePath="analyzers\dotnet\cs\"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pumpkin.DotNet.Tests" />
  </ItemGroup>

</Project>